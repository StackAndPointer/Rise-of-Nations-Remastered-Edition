digraph "GameLog"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="GameLog",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="游戏日志结构体，用于记录游戏运行时的各种信息"];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="Log",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$struct_log.html",tooltip="日志结构 - 用于游戏日志记录"];
  Node3 -> Node1 [id="edge2_Node000001_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="GameAccessConst",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$struct_game_access_const.html",tooltip="游戏访问常量结构体，可能用作基类或占位符"];
  Node4 -> Node1 [id="edge3_Node000001_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="MiscAccess",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$struct_misc_access.html",tooltip="组合框控件（继承自GraphicWin）"];
}
